# Copy to .env for local dev; set the same keys in Vercel → Settings → Environment Variables for production.

# Public site URL — used for Dodo's post-checkout return URL. No trailing slash.
NEXT_PUBLIC_BASE_URL=https://skoolvideosaver.com
# Chrome Web Store listing (optional; defaults to the published listing in src/lib/site.ts).
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/elgolnjjeieninahlmogcoijmmmobdca

# NextAuth — must match the public URL in production. Generate the secret with: openssl rand -hex 32
NEXTAUTH_URL=https://skoolvideosaver.com
NEXTAUTH_SECRET=

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skoolvideosaver?appName=Cluster0"

# Which gateway handles NEW checkouts: dodo (default if unset) or stripe. Both webhooks stay live.
PAYMENT_GATEWAY=dodo

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Price id from Stripe → Product catalog (price_...)
STRIPE_MONTHLY_PRICE_ID=price_...

# Dodo Payments
DODO_PAYMENTS_API_KEY=
# live_mode or test_mode (defaults to live_mode in production builds, test_mode in dev)
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_...
# Test-mode product IDs — replace with the live-mode IDs when going live.
DODO_MONTHLY_PRODUCT_ID=pdt_0NmbwMLzmoAJNpKV31hA4
DODO_LIFETIME_PRODUCT_ID=pdt_0Nmbu0Z0SLfLTH5jRj2C9

# Admin panel (/admin). Escape every $ in the bcrypt hash as \$ in .env files.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Web3Forms access key: emails contact form messages. Public by design (used in the browser).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
